# 注意：值后面不要写注释（systemd 不支持行尾注释）

# ===== 必填 =====
# 找 @BotFather 创建机器人后得到
BOT_TOKEN=

# ===== 可选：大文件模式 =====
# 留空 = Bot API 模式，单文件上限 50MB（超过会自动降低画质）
# 填上 = MTProto 模式，单文件上限 2GB。登录 https://my.telegram.org -> API development tools 创建应用后得到
API_ID=
API_HASH=

# ===== 权限 =====
# 管理员的 Telegram 数字 ID，多个用逗号分隔。不知道就先空着，启动后给机器人发 /id
ADMIN_IDS=
# 其他允许使用的用户 ID，逗号分隔。填 * 表示任何人都能用（不建议，小鸡扛不住）
ALLOWED_USERS=

# ===== 资源限制（默认值按 1 核 / 512MB 内存 / 2GB 磁盘调好）=====
# 单个文件上限（MB）。实际上限还会按剩余磁盘自动缩小
MAX_FILE_MB=500
# 最高分辨率，720 比较省空间；想要 1080p 改成 1080
MAX_HEIGHT=720
# 给系统保留的磁盘空间（MB）
DISK_RESERVE_MB=200
# 同时下载的任务数，小鸡保持 1
MAX_CONCURRENT=1
# 总排队上限 / 每人排队上限
MAX_QUEUE=10
PER_USER_QUEUE=3
# 单个任务下载超时（秒）
DOWNLOAD_TIMEOUT=1800

# ===== 可选 =====
# YouTube 提示 "Sign in to confirm you're not a bot" 时，导出 cookies.txt 放到 /opt/tgdl/data/ 下并填完整路径
COOKIES_FILE=
# 下载走代理，例如 socks5://127.0.0.1:1080
PROXY=
# 额外的 yt-dlp 参数，例如 --limit-rate 5M
YTDLP_EXTRA_ARGS=
